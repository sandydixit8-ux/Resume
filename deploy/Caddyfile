# Caddyfile — ResumeIQ AI reverse proxy (auto-HTTPS)
# Replace yourdomain.com with your real domain, then:
#   caddy run --config Caddyfile   (or: sudo systemctl enable --now caddy)
#
# Traffic: browser -> Caddy (HTTPS) -> frontend -> /api/v1 rewrites -> backend
# Bare-metal (systemd): frontend on 127.0.0.1:3000 (default, no env needed).
# Docker (compose): set UPSTREAM_FRONTEND=frontend:3000 (compose does this).

yourdomain.com {
    encode zstd gzip
    reverse_proxy {$UPSTREAM_FRONTEND:127.0.0.1:3000}
}

# Optional: expose the API directly for external integrations (e.g. the API-access
# plan feature). Uncomment and set a DNS A record for api.yourdomain.com.
# api.yourdomain.com {
#     encode zstd gzip
#     reverse_proxy 127.0.0.1:8000
# }
