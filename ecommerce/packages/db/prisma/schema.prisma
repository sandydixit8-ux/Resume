datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING_VERIFICATION
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
  DISABLED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PLACED
  PAYMENT_PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  RETURN_REQUESTED
  RETURN_APPROVED
  PICKUP_SCHEDULED
  RETURNED
  REFUND_PENDING
  REFUNDED
}

enum PaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  WALLET
  COD
  EMI
  PAYMENT_LINK
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TransactionType {
  AUTHORIZE
  CAPTURE
  VOID
  REFUND
  CHARGEBACK
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum RefundType {
  FULL
  PARTIAL
  STORE_CREDIT
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RTO
  RETURNED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  BUY_X_GET_Y
  CATEGORY
  PRODUCT
  BRAND
  FIRST_ORDER
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum KycStatus {
  NOT_STARTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RESERVE
  RELEASE
  ADJUSTMENT
  DAMAGE
  RETURN
  TRANSFER
}

enum InventoryTransferStatus {
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTISELECT
  COLOR
}

enum PricingRuleType {
  FIXED_DISCOUNT
  PERCENTAGE_DISCOUNT
  TIERED_PRICING
  CUSTOMER_SPECIFIC
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique
  phone            String?    @unique
  passwordHash     String     @map("password_hash")
  name             String
  status           UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?  @map("email_verified_at")
  phoneVerifiedAt  DateTime?  @map("phone_verified_at")
  lastLoginAt      DateTime?  @map("last_login_at")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until")
  loyaltyPoints    Int        @default(0) @map("loyalty_points")
  deletedAt        DateTime?  @map("deleted_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  addresses          Address[]
  userRoles          UserRole[]
  sessions           Session[]
  passwordResets     PasswordReset[]
  orders             Order[]
  wishlists          Wishlist[]
  notifications      Notification[]
  reviews            Review[]
  promotionItems     PromotionItem[]
  reviewVotes        ReviewVote[]
  couponRedemptions  CouponRedemption[]
  carts              Cart[]
  seller             Seller?
  tickets            SupportTicket[]
  inventoryTransfers InventoryTransfer[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assignments     UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  sellerId  String?  @map("seller_id") @db.Uuid
  grantedBy String?  @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?
  ip               String?
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OtpToken {
  id          String    @id @default(uuid()) @db.Uuid
  destination String
  channel     String
  codeHash    String    @map("code_hash")
  purpose     String
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([destination, purpose])
  @@map("otp_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Address {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  label             String?
  fullName          String    @map("full_name")
  phone             String
  line1             String
  line2             String?
  landmark          String?
  city              String
  state             String
  country           String    @default("IN")
  pincode           String
  isDefaultShipping Boolean   @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean   @default(false) @map("is_default_billing")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pincode])
  @@map("addresses")
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String
  slug           String    @unique
  path           String
  level          Int       @default(1)
  imageUrl       String?   @map("image_url")
  description    String?
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  seoKeywords    String?   @map("seo_keywords")
  position       Int       @default(0)
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]          @relation("CategoryTree")
  products           Product[]
  categoryAttributes CategoryAttribute[]

  @@index([parentId])
  @@index([path])
  @@map("categories")
}

model Attribute {
  id            String            @id @default(uuid()) @db.Uuid
  code          String            @unique
  name          String
  dataType      AttributeDataType @map("data_type")
  unit          String?
  isVariantAxis Boolean           @default(false) @map("is_variant_axis")
  isFilterable  Boolean           @default(false) @map("is_filterable")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  categoryAttributes     CategoryAttribute[]
  attributeValues        AttributeValue[]
  variantAttributeValues VariantAttributeValue[]
  productAttributes      ProductAttribute[]

  @@map("attributes")
}

model AttributeValue {
  id          String @id @default(uuid()) @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  value       String
  slug        String
  meta        Json?
  position    Int    @default(0)

  attribute              Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantAttributeValues VariantAttributeValue[]
  productAttributes      ProductAttribute[]

  @@index([attributeId])
  @@map("attribute_values")
}

model CategoryAttribute {
  id                String  @id @default(uuid()) @db.Uuid
  categoryId        String  @map("category_id") @db.Uuid
  attributeId       String  @map("attribute_id") @db.Uuid
  isRequired        Boolean @default(false) @map("is_required")
  isFilterable      Boolean @default(false) @map("is_filterable")
  inheritToChildren Boolean @default(true) @map("inherit_to_children")
  position          Int     @default(0)

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@map("category_attributes")
}

model Brand {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  slug           String    @unique
  logoUrl        String?   @map("logo_url")
  description    String?
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model Product {
  id               String                   @id @default(uuid()) @db.Uuid
  sku              String                   @unique
  name             String
  slug             String                   @unique
  shortDescription String?                  @map("short_description")
  description      String?
  brandId          String?                  @map("brand_id") @db.Uuid
  categoryId       String                   @map("category_id") @db.Uuid
  sellerId         String?                  @map("seller_id") @db.Uuid
  status           ProductStatus            @default(DRAFT)
  taxClassId       String?                  @map("tax_class_id") @db.Uuid
  mrp              Decimal                  @db.Decimal(12, 2)
  sellingPrice     Decimal                  @map("selling_price") @db.Decimal(12, 2)
  currency         String                   @default("INR")
  weightG          Int?                     @map("weight_g")
  lengthMm         Int?                     @map("length_mm")
  widthMm          Int?                     @map("width_mm")
  heightMm         Int?                     @map("height_mm")
  warrantyText     String?                  @map("warranty_text")
  returnEligible   Boolean                  @default(true) @map("return_eligible")
  ratingsAvg       Decimal                  @default(0) @map("ratings_avg") @db.Decimal(3, 2)
  ratingsCount     Int                      @default(0) @map("ratings_count")
  salesCount       Int                      @default(0) @map("sales_count")
  isFeatured       Boolean                  @default(false) @map("is_featured")
  seoTitle         String?                  @map("seo_title")
  seoDescription   String?                  @map("seo_description")
  seoKeywords      String?                  @map("seo_keywords")
  searchVector     Unsupported("tsvector")? @map("search_vector")
  publishedAt      DateTime?                @map("published_at")
  deletedAt        DateTime?                @map("deleted_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  brand              Brand?              @relation(fields: [brandId], references: [id])
  category           Category            @relation(fields: [categoryId], references: [id])
  taxClass           TaxClass?           @relation(fields: [taxClassId], references: [id])
  seller             Seller?             @relation(fields: [sellerId], references: [id])
  variants           ProductVariant[]
  images             ProductImage[]
  videos             ProductVideo[]
  attributes         ProductAttribute[]
  relations          ProductRelation[]   @relation("ProductRelated")
  relatedTo          ProductRelation[]   @relation("ProductRelationTarget")
  reviews            Review[]
  orderItems         OrderItem[]
  recentlyViewed     RecentlyViewed[]
  collectionProducts CollectionProduct[]
  sellerListings     SellerProduct[]
  priceHistory       PriceHistory[]
  promotionItems     PromotionItem[]

  @@index([categoryId, status, sellingPrice])
  @@index([brandId, status])
  @@index([status, ratingsCount])
  @@index([searchVector], type: Gin)
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  sku        String   @unique
  name       String
  price      Decimal  @db.Decimal(12, 2)
  mrp        Decimal  @db.Decimal(12, 2)
  taxClassId String?  @map("tax_class_id") @db.Uuid
  weightG    Int?     @map("weight_g")
  barcode    String?
  position   Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventories            Inventory[]
  orderItems             OrderItem[]
  cartItems              CartItem[]
  wishlistItems          WishlistItem[]
  variantAttributeValues VariantAttributeValue[]
  images                 ProductImage[]
  priceHistory           PriceHistory[]
  priceTiers             PriceTier[]
  transferItems          InventoryTransferItem[]
  promotionItems         PromotionItem[]

  @@index([productId])
  @@map("product_variants")
}

model PriceHistory {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String?  @map("product_id") @db.Uuid
  productVariantId String?  @map("product_variant_id") @db.Uuid
  fieldName        String   @map("field_name")
  fromValue        Decimal  @map("from_value") @db.Decimal(12, 2)
  toValue          Decimal  @map("to_value") @db.Decimal(12, 2)
  reason           String?
  actorId          String?  @map("actor_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  product        Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([productVariantId, createdAt])
  @@map("price_history")
}

model PriceTier {
  id               String   @id @default(uuid()) @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  minQuantity      Int      @map("min_quantity")
  price            Decimal  @db.Decimal(12, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, minQuantity])
  @@index([productVariantId, isActive])
  @@map("price_tiers")
}

model VariantAttributeValue {
  id               String  @id @default(uuid()) @db.Uuid
  variantId        String  @map("variant_id") @db.Uuid
  attributeId      String  @map("attribute_id") @db.Uuid
  attributeValueId String? @map("attribute_value_id") @db.Uuid
  rawValue         String? @map("raw_value")

  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@map("variant_attribute_values")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  url       String
  alt       String?
  width     Int?
  height    Int?
  position  Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVideo {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  url          String
  thumbnailUrl String? @map("thumbnail_url")
  position     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_videos")
}

model ProductAttribute {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  attributeId      String   @map("attribute_id") @db.Uuid
  attributeValueId String?  @map("attribute_value_id") @db.Uuid
  valueText        String?  @map("value_text")
  valueNumber      Decimal? @map("value_number") @db.Decimal(16, 6)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_attributes")
}

model ProductRelation {
  id               String @id @default(uuid()) @db.Uuid
  productId        String @map("product_id") @db.Uuid
  relatedProductId String @map("related_product_id") @db.Uuid
  relationType     String @map("relation_type")
  position         Int    @default(0)

  product        Product @relation("ProductRelated", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductRelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId, relationType])
  @@map("product_relations")
}

model Collection {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  type           String   @default("manual")
  rules          Json?
  isActive       Boolean  @default(true) @map("is_active")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  collectionProducts CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

model TaxClass {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  rate      Decimal  @db.Decimal(5, 2)
  config    Json?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("tax_classes")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  line1     String?
  city      String?
  state     String?
  pincode   String?
  isActive  Boolean  @default(true) @map("is_active")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inventories          Inventory[]
  shipments            Shipment[]
  transferSources      InventoryTransfer[] @relation("TransferSource")
  transferDestinations InventoryTransfer[] @relation("TransferDestination")

  @@map("warehouses")
}

model Inventory {
  id                String   @id @default(uuid()) @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  productVariantId  String   @map("product_variant_id") @db.Uuid
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  damagedQuantity   Int      @default(0) @map("damaged_quantity")
  returnedQuantity  Int      @default(0) @map("returned_quantity")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  reorderPoint      Int      @default(0) @map("reorder_point")
  reorderQuantity   Int      @default(0) @map("reorder_quantity")
  updatedAt         DateTime @updatedAt @map("updated_at")

  warehouse           Warehouse               @relation(fields: [warehouseId], references: [id])
  variant             ProductVariant          @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  movements           InventoryMovement[]
  transferSourceItems InventoryTransferItem[] @relation("TransferSourceInventory")
  transferDestItems   InventoryTransferItem[] @relation("TransferDestinationInventory")

  @@unique([warehouseId, productVariantId])
  @@index([productVariantId])
  @@map("inventory")
}

model InventoryTransfer {
  id                     String                  @id @default(uuid()) @db.Uuid
  referenceNumber        String                  @unique @map("reference_number")
  sourceWarehouseId      String                  @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String                  @map("destination_warehouse_id") @db.Uuid
  status                 InventoryTransferStatus @default(COMPLETED)
  note                   String?
  createdById            String?                 @map("created_by_id") @db.Uuid
  completedAt            DateTime?               @map("completed_at")
  createdAt              DateTime                @default(now()) @map("created_at")

  sourceWarehouse      Warehouse               @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse               @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])
  createdBy            User?                   @relation(fields: [createdById], references: [id])
  items                InventoryTransferItem[]

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id                     String @id @default(uuid()) @db.Uuid
  transferId             String @map("transfer_id") @db.Uuid
  productVariantId       String @map("product_variant_id") @db.Uuid
  sourceInventoryId      String @map("source_inventory_id") @db.Uuid
  destinationInventoryId String @map("destination_inventory_id") @db.Uuid
  quantity               Int

  transfer             InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant              ProductVariant    @relation(fields: [productVariantId], references: [id])
  sourceInventory      Inventory         @relation("TransferSourceInventory", fields: [sourceInventoryId], references: [id])
  destinationInventory Inventory         @relation("TransferDestinationInventory", fields: [destinationInventoryId], references: [id])

  @@index([transferId])
  @@index([productVariantId])
  @@map("inventory_transfer_items")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  inventoryId   String                @map("inventory_id") @db.Uuid
  type          InventoryMovementType
