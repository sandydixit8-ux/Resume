  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("seller_kyc")
}

model SellerPayout {
  id          String    @id @default(uuid()) @db.Uuid
  sellerId    String    @map("seller_id") @db.Uuid
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")
  gross       Decimal   @db.Decimal(12, 2)
  commission  Decimal   @db.Decimal(12, 2)
  deductions  Decimal   @default(0) @db.Decimal(12, 2)
  net         Decimal   @db.Decimal(12, 2)
  status      String    @default("PENDING")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([sellerId, status])
  @@map("seller_payouts")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @default("My Wishlist")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@index([userId])
  @@map("wishlists")
}

model WishlistItem {
  id                String   @id @default(uuid()) @db.Uuid
  wishlistId        String   @map("wishlist_id") @db.Uuid
  productVariantId  String   @map("product_variant_id") @db.Uuid
  notifyPriceDrop   Boolean  @default(false) @map("notify_price_drop")
  notifyBackInStock Boolean  @default(false) @map("notify_back_in_stock")
  addedAt           DateTime @default(now()) @map("added_at")

  wishlist Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productVariantId])
  @@map("wishlist_items")
}

model RecentlyViewed {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  anonId    String?  @map("anon_id")
  productId String   @map("product_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([anonId, viewedAt])
  @@map("recently_viewed")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorType    String?  @map("actor_type")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  oldValue     Json?
  newValue     Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventName  String   @map("event_name")
  userId     String?  @map("user_id") @db.Uuid
  anonId     String?  @map("anon_id")
  sessionId  String?  @map("session_id")
  properties Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventName, createdAt])
  @@map("analytics_events")
}

model SearchQuery {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  anonId           String?  @map("anon_id")
  query            String
  resultCount      Int?     @map("result_count")
  clickedProductId String?  @map("clicked_product_id") @db.Uuid
  addedToCart      Boolean  @default(false) @map("added_to_cart")
  purchased        Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([query, createdAt])
  @@map("search_queries")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  rules     Json?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}
