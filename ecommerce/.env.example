# ===== API =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=4000
NODE_ENV="development"
LOG_LEVEL="debug"
API_URL="http://localhost:4000"
STORE_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ===== Auth =====
JWT_ACCESS_SECRET="change-me-32-chars-min"
JWT_REFRESH_SECRET="change-me-32-chars-min-different"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# ===== Prisma / bootstrap =====
FIRST_ADMIN_EMAIL="admin@example.com"
FIRST_ADMIN_PASSWORD="change-me-strong-password"
FIRST_ADMIN_NAME="Platform Admin"

# ===== Rate limiting =====
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ===== Providers (stubs for foundation) =====
EMAIL_PROVIDER="console"
SMS_PROVIDER="console"
PAYMENT_PROVIDER="none"
SHIPPING_PROVIDER="none"

# ===== Storage (Phase 2) =====
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
CDN_DOMAIN=""