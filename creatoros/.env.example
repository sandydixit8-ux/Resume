# Core
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=data/creatoros.db

# Admin (comma separated emails)
ADMIN_EMAILS=

# AI (OpenAI compatible)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: custom SMTP for emails (fallback logs to console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Stripe (optional - enable billing when set)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Feature flags
FEATURE_BOOKING=true
FEATURE_AI=true