# ------------------------------------------------------------------
# CoinDCX Institutional Quant Trading Agent - environment template
# Copy to .env and fill in values. NEVER commit .env.
# ------------------------------------------------------------------

# API credentials (create at https://coindcx.com/api-dashboard)
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Execution mode: backtest | paper | live
TA_MODE=paper

# Optional news API (GNews/NewsAPI) for sentiment. Leave empty to disable.
NEWS_API_KEY=
NEWS_API_BASE=https://gnews.io/api/v4/search

# Optional LLM key for deep reasoning pass (used only if set).
TA_LLM_API_KEY=
