# RankPilot AI environment
RANKPILOT_DB_PATH=data/rankpilot.db
AUTH_SECRET=change-me-to-a-long-random-string
# Optional: enables AI generation features
OPENAI_API_KEY=
# Optional: enables real search-volume enrichment (never fabricate when absent)
KEYDATA_API_KEY=
# Crawler politeness
CRAWLER_USER_AGENT=RankPilotBot/1.0 (+https://rankpilot.ai/bot)
CRAWLER_TIMEOUT_MS=15000
CRAWLER_MAX_PAGES=200
# Client IP trust. Leave unset unless a proxy you control sets X-Forwarded-For.
# When unset, IP-keyed rate limits (login, register, free audit) treat every
# client as one shared bucket, because a directly-exposed server cannot tell a
# real address from a forged header. Set to 1 behind a trusted reverse proxy;
# TRUSTED_PROXY_HOPS is the number of proxies in front of the app (default 1).
TRUSTED_PROXY=
TRUSTED_PROXY_HOPS=1
# Background jobs. A job left "running" by a worker that died is requeued after
# this lease expires. Keep it comfortably ABOVE your slowest real job (a full
# agency crawl is the worst case) or healthy work gets reaped and run twice.
# There is no heartbeat, so this is a fixed reclaim timeout, not a renewal.
RANKPILOT_JOB_LEASE_MS=7200000
# Set to "off" for read-only replicas that should not claim jobs.
RANKPILOT_WORKER=on
# Outbound email. Required for password reset and address verification; without
# it those endpoints return 503 with an explicit "not configured" reason rather
# than pretending to send. EMAIL_PROVIDER selects the transport (only "webhook"
# ships today); the webhook is called with {to, from, template, subject, text}.
EMAIL_PROVIDER=webhook
EMAIL_WEBHOOK_URL=

# --- Public site URL --------------------------------------------------------
# The origin this deployment is reached at. Set this in production.
# It is the single source for: canonical tags, Open Graph/Twitter image URLs,
# JSON-LD @id fields, sitemap.xml, robots.txt, and the origin of password-reset
# and email-verification links.
#
# Do NOT rename this to a NEXT_PUBLIC_ variable. Next.js inlines those at BUILD
# time, so a value set only in the server's EnvironmentFile would be ignored and
# the site would serve canonical tags, sitemap.xml and robots.txt all pointing at
# http://localhost:3000 -- with nothing failing. Everything here is
# server-rendered and read at runtime.
#
# It must ALSO be set at BUILD time, not just at runtime. The public pages,
# sitemap.xml and robots.txt are statically prerendered, so their canonical tags,
# og:image URLs and JSON-LD @id values are baked in during `npm run build`.
# deploy/deploy.sh refuses to build without it. Nothing errors if you skip this;
# the site just quietly tells search engines it lives on localhost.
#
# These two older spellings are still accepted as fallbacks. Prefer SITE_URL.
# APP_URL=http://localhost:3000
# RANKPILOT_PUBLIC_URL=
SITE_URL=
# Optional bearer token sent to the email webhook.
EMAIL_WEBHOOK_TOKEN=
EMAIL_FROM=RankPilot <no-reply@rankpilot.ai>
# Token lifetimes, in minutes.
RESET_TOKEN_TTL_MINUTES=60
VERIFY_TOKEN_TTL_MINUTES=1440
# Retention for anonymous free audits, which store an email address and an IP.
# Policy, not code: change it without a deploy. Rows are deleted by the
# retention pass, not by a database TTL.
FREE_AUDIT_RETENTION_DAYS=30

# --- Backups -------------------------------------------------------------
# Output directory for scripts/backup.ts.
RANKPILOT_BACKUP_DIR=backups
# Passphrase for encrypting backups (AES-256-GCM, key derived with scrypt).
# If set, db:backup writes a .db.enc and deletes the plaintext snapshot, and
# db:restore-test decrypts it and asserts the recovered database is
# bit-for-bit identical to the one that was backed up.
# If unset, backups are written unencrypted and the script prints a warning.
# TREAT THIS AS A SECRET. Losing it means every encrypted backup is
# unrecoverable, so store it in a password manager, not just in this file.
BACKUP_PASSPHRASE=
# Delete snapshots older than this many days. The 7 most recent are always
# kept regardless of age, so a bad value cannot empty the backup directory.
# Unset means backups accumulate forever.
BACKUP_RETENTION_DAYS=30
# How old the newest snapshot may get before GET /api/admin/status reports
# stale. A daily job that runs slightly late should not raise a false alarm, but
# one that has missed a run should. Default 26 if unset or unparseable.
BACKUP_STALE_HOURS=26
# db:restore-test verifies a restore and then deletes the snapshot it made,
# because a verification run must not leave artifacts that look like backups.
# Set to 1 to keep it (e.g. when you ran it wanting a backup as well).
BACKUP_KEEP_VERIFY_SNAPSHOT=

# --- Analytics: Search Console ----------------------------------------------
# Server-to-server Google Search Console pull. Create a service account in the
# Google Cloud console, add it as a user of the Search Console property you want
# to read, and put its email + PEM key here. GSC_CLIENT_EMAIL + GSC_PRIVATE_KEY
# must both be set or /api/analytics/import answers "unavailable" (never
# estimates). Newlines in the PEM may be literal or escaped as \n.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
# Search Console metrics finalize ~2-3 days late; the sync reserves that many
# trailing days so provisional figures are never imported. 0 disables the
# reservation (not recommended). Default 3.
#GSC_DEADLINE_DAYS=3

# --- CMS: WordPress ---------------------------------------------------------
# CMS auto-fix only touches a site when a WordPress application password is
# configured. All three are required; https is mandatory because WordPress
# rejects application passwords over plain HTTP. Without them every proposed fix
# stops at "blocked" and the site is never modified. Create the password under
# Users → Profile → Application Passwords, and give it only the permissions the
# fix needs (edit_posts).
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- Billing ----------------------------------------------------------------
# Stripe powers paid plans. STRIPE_SECRET_KEY creates Checkout Sessions;
# STRIPE_WEBHOOK_SECRET verifies the webhook events that upgrade/keep plans.
# Without both, /api/billing/checkout and /api/billing/webhook answer 503
# "Stripe is not configured" — plans are never granted for free.
# STRIPE_PRICE_<PLAN> map internal plans to Stripe price ids (subscription prices).
# Webhook event handling maps a subscription's price back to the plan, so a plan
# change made inside Stripe rounds back to us.
# Enable the webhook in the Stripe dashboard for these event types at
# <SITE_URL>/api/billing/webhook:
#   checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
# No payment provider is connected, so paid plans are not on sale -- unless
# Stripe keys above are set. If they are set, upgrades flow through the Stripe
# checkout + webhook, and the local PATCH below remains locked down.
# Because every user owns the organisation they registered, an "owner only"
# permission check does NOT prevent self-serve upgrades -- a throwaway account
# could otherwise claim the top tier for free. PATCH /api/billing therefore
# refuses any plan change that is not a downgrade unless the caller's email is
# listed here. Empty (the default) means nobody can self-serve upgrade, which is
# the safe direction.
# List only addresses that should be able to exercise paid behaviour in a demo
# or staging environment, comma-separated. Do not populate in production.
BILLING_SELF_SERVE_EMAILS=

# --- OAuth (Sign in with Google) -----------------------------------------
# Enables POST account creation and login through Google's OAuth/OIDC. Without
# these the /api/auth/oauth/* endpoints answer 503 "not configured" — they never
# silently fall back to an unauthenticated path.
#
# Create a project at https://console.cloud.google.com/apis/credentials and set
# the Authorized redirect URI to <SITE_URL>/api/auth/oauth/google/callback
# (e.g. https://rankpilot.ai/api/auth/oauth/google/callback).
# The flow uses PKCE (S256) + a signed, short-lived state cookie; the callback
# verifies Google's RS256-signed id_token against Google's published JWKS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Deployment-time health probes ---------------------------------------
#   /api/health/live  -> process alive; must NOT depend on the database
#   /api/health/ready -> can serve traffic; 503 when the database is unreachable
#   /api/health       -> alias of /ready, kept for existing probes
RANKPILOT_SCHEDULES=on
